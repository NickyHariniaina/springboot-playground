### Variables ( paste your generated token here)
@token =
@baseUrl = http://localhost:8080

### Login
POST {{baseUrl}}/api/public/auth/login
Content-Type: application/json

{
    "username": "admin",
    "password": "123456"
}

### Register
POST {{baseUrl}}/api/public/auth/register
Content-Type: application/json

{
    "username": "admin",
    "password": "123456"
}

### Get all users
GET {{baseUrl}}/api/users
Authorization: Bearer {{token}}

